# ── Database ──────────────────────────────────────────────────────────────────
# MySQL connection string. Format: mysql://user:password@host:3306/database
# Recommended providers: PlanetScale, Railway, Aiven, or self-hosted MySQL
DATABASE_URL="mysql://user:password@localhost:3306/smb_audit"

# ── Authentication ────────────────────────────────────────────────────────────
# Single password to access the app. Set this in Vercel environment variables.
SITE_PASSWORD="your-secure-password-here"

# ── AI (OpenRouter) ───────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# Optional: override the default AI model (default: anthropic/claude-3.5-sonnet)
# OPENROUTER_MODEL="openai/gpt-4o"

# Optional: your app's public URL (used in OpenRouter request headers)
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
