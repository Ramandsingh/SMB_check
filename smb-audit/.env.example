# ── Database ──────────────────────────────────────────────────────────────────
# Used by the Next.js app to connect to MySQL
DATABASE_URL="mysql://smb_user:yourpassword@db:3306/smb_audit"

# MySQL container credentials (must match DATABASE_URL above)
MYSQL_ROOT_PASSWORD="yourrootpassword"
MYSQL_USER="smb_user"
MYSQL_PASSWORD="yourpassword"

# ── Authentication ────────────────────────────────────────────────────────────
SITE_PASSWORD="your-secure-password-here"

# ── AI (OpenRouter) ───────────────────────────────────────────────────────────
OPENROUTER_API_KEY="sk-or-v1-..."

# Optional: override default AI model
# OPENROUTER_MODEL="openai/gpt-4o"

# Optional: your app URL
# NEXT_PUBLIC_APP_URL="http://157.211.8.130:3000"
